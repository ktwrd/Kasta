@using Kasta.Data
@using Kasta.Data.Models
@using Kasta.Web.Models.Components
@using Microsoft.AspNetCore.Identity
@model LinkListViewModel
@inject UserManager<UserModel> UserManager
@{
    var userModel = await UserManager.GetUserAsync(User);
    var allowVanity = false;
    if (userModel != null)
    {
        allowVanity = await UserManager.IsInRoleAsync(userModel, RoleKind.LinkShortenerCreateVanity)
        || await UserManager.IsInRoleAsync(userModel, RoleKind.Administrator);
    }

    var modalHidden = Model.OpenCreateModal ? "false" : "true";
}

<div class="modal fade" id="createLinkModal" tabindex="-1" aria-labelledBy="createLinkModalLabel" aria-hidden="@modalHidden">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="LinkShortener" asp-action="CreateLink" asp-area=""
                  enctype="multipart/form-data"
                  method="POST">
                <input type="hidden" name="page" value="@Model.Page" />
                <div class="modal-header">
                    <h5 class="modal-title" id="createLinkModalLabel">Create Link</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.CreateModalAlert != null)
                    {
                        @await Component.InvokeAsync("Alert", Model.CreateModalAlert)
                    }
                    <div class="mb-3">
                        @await Component.InvokeAsync(
                            "FormText", new FormTextComponentViewModel()
                            {
                                Id = "text-destination",
                                Name = "link",
                                Value = Model.CreateModalModel.Destination,
                                DisplayName = "Destination URL",
                                Required = true
                            })
                    </div>
                    @if (allowVanity)
                    {
                        <div class="mb-3">
                            @await Component.InvokeAsync(
                                "FormCheckbox", new FormCheckboxComponentViewModel()
                                {
                                    Id = "checkbox-vanity",
                                    Name = "useVanity",
                                    State = Model.CreateModalModel.UseVanity,
                                    Label = "Use Vanity"
                                })
                        </div>
                        <div class="mb-3">
                            @await Component.InvokeAsync(
                                "FormText", new FormTextComponentViewModel()
                                {
                                    Id = "text-vanity",
                                    Name = "vanity",
                                    Value = Model.CreateModalModel.Vanity,
                                    DisplayName = "Vanity Link Value"
                                })
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
