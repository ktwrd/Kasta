@using Kasta.Web.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@model NotFoundViewModel?
@{
    bool isAlert = false;
    if (HttpContextAccessor.HttpContext != null)
    {
        Model?.Update(HttpContextAccessor.HttpContext);
        isAlert = (Model?.IsAlert ?? false)
            || HttpContextAccessor.HttpContext.IsHtmxRequest();
    }
}

@if (isAlert)
{
    <div class="alert alert-danger">
        <h4 class="alert-heading">Not Found</h4>
        <p>The file or page you requested for could not be found.</p>
        @if (!string.IsNullOrEmpty(Model?.Message?.Trim()))
        {
            <hr />
            if (Model.MessageMarkdown)
            {
                @Html.Raw(KastaWebHelper.MarkdownToHtmlBasic(Model.Message))
            }
            else
            {
                <text>@Model.Message</text>
            }
        }
    </div>
}
else
{
    @if (Model?.ShowHeader != false)
    {
        <h1>Not Found</h1>
    }
    <div class="mb-3">
        <p>The file or page you requested for could not be found.</p>
        @if (!string.IsNullOrEmpty(Model?.Message?.Trim()))
        {
            <hr/>
            if (Model.MessageMarkdown)
            {
                @Html.Raw(KastaWebHelper.MarkdownToHtmlBasic(Model.Message))
            }
            else
            {
                <text>@Model.Message</text>
            }
        }
    </div>
}

