@inject IHttpContextAccessor HttpContextAccessor
@model BadRequestViewModel?
@{
    var isHtmx = false;
    if (HttpContextAccessor.HttpContext?.IsHtmxRequest() == true)
    {
        isHtmx = true;
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Bad Request";
        Layout = "_Layout";
    }
}

@if (isHtmx)
{
    <div class="alert alert-warning">
        <h4 class="alert-heading">Bad Request</h4>
        <p>The request that was made has invalid user input.</p>
        @if (!string.IsNullOrEmpty(Model?.Message))
        {
            <p>@Model!.Message</p>
        }
    </div>
}
else
{
    <h1>Bad Request</h1>
    <p>The request that was made has invalid user input.</p>
    @if (!string.IsNullOrEmpty(Model?.Message))
    {
        <p>@Model!.Message</p>
    }
}
