@inject IHttpContextAccessor HttpContextAccessor
@model NotFoundViewModel
@{
    if (HttpContextAccessor.HttpContext?.IsHtmxRequest() == true)
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Not Found";
        Layout = "_Layout";
    }
}
@{
    await Html.RenderPartialAsync("_PartialNotFound", Model);
}
